# Copier ce fichier en .env et renseigner les valeurs reelles.
# Necessaire pour le mode "reponse redigee" (RAG + LLM) et pour l'analyse
# d'images jointes. Le mode "chemin direct" n'en a pas besoin.

GROQ_API_KEY=ta_cle_groq_ici

# Optionnel : override des modeles par defaut (voir src/config.py).
# Utile si Groq deprecie/renomme un modele -- pas besoin de modifier le
# code, juste ces deux lignes. Verifie les modeles disponibles sur ton
# compte via : curl.exe https://api.groq.com/openai/v1/models -H "Authorization: Bearer TA_CLE"
# GROQ_MODEL=openai/gpt-oss-120b